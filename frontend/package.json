{
  "name": "sigma",
  "version": "1.0.0",
  "private": true,
  "description": "СИГМА — интерфейс мониторинга пабликов и анализа комментариев",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config vite.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "host:ip": "node -e \"const i=require('os').networkInterfaces();for(const k of Object.keys(i)){for(const a of i[k]){if(a.family==='IPv4'&&!a.internal)console.log(k+':',a.address)}}\""
  },
