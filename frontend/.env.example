# Фронтенд (Vite) — переменные VITE_* инлайнятся в сборку.
# Реальные значения кладём в frontend/.env (в гит не коммитим) или в CI/CD variables.

VITE_API_BASE_URL=
VITE_YANDEX_MAPS_KEY=

# EmailJS (обратная связь на лендинге)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
