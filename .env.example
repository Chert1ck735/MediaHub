# Environment
APP_ENV=dev

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=media_project
DB_USER=postgres
DB_PASS=change_this_local_password

# Auth (JWT)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# CORS (comma-separated origins, required on prod)
CORS_ALLOWED_ORIGINS=

# LLM backend: openai | ollama
LLM_PROVIDER=openai

# OpenAI-compatible endpoint (used when LLM_PROVIDER=openai)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/engines/llama.cpp/v1
OPENAI_COMPATIBLE_API_KEY=dummy
OPENAI_COMPATIBLE_MODEL=huggingface.co/therains/qwen2.5-14b-instruct-q4_k_m-gguf:latest
OPENAI_COMPATIBLE_TIMEOUT=240

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=240

# Включайте после настройки отдельной модели предварительной фильтрации.
# Иначе достаточно одной модели, заданной выше.
ANALYTICS_PREFILTER_ENABLED=false

# LLM generation budgets (tokens)
OLLAMA_NUM_PREDICT_POST=800
OLLAMA_NUM_PREDICT_ANALYTICS=700

# VK API
ACCESS_TOKEN=
GROUP_ID=0

# Telegram (необязательно; подробнее docs/telegram.md)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_MAX_POSTS=200
TELEGRAM_COMMENT_FETCH_CONCURRENCY=3
TELEGRAM_PROXY_ENABLED=true
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=1443
TELEGRAM_PROXY_SECRET=

# VK parser
VK_PARSER_GROUP_DOMAIN=
VK_PARSER_COUNT_PER_REQUEST=10
VK_PARSER_MAX_POSTS=10

# OK API (Одноклассники).
# application_key / application_secret_key — старый кабинет OK.
# OK_ACCESS_TOKEN — токен админа группы (OAuth через VK ID),
# приложению нужны права VALUABLE_ACCESS и GROUP_CONTENT.
OK_APPLICATION_KEY=
OK_APPLICATION_SECRET_KEY=
OK_ACCESS_TOKEN=
OK_GROUP_ID=

# Автопарсер комментариев (фоновый воркер).
# Раз в AUTOPARSE_INTERVAL_HOURS проверяет активные паблики организаций и, если
# за AUTOPARSE_LOOKBACK_DAYS у сети появились неспаршенные комменты, тянет их.
# AUTOPARSE_ENABLED=false полностью выключает воркер.
AUTOPARSE_ENABLED=true
AUTOPARSE_INTERVAL_HOURS=24
AUTOPARSE_LOOKBACK_DAYS=7
AUTOPARSE_CHECK_INTERVAL_SECONDS=3600
AUTOPARSE_MAX_POSTS=200

# Sentry
# ── Sentry: трекинг ошибок ───────────────────────────────────────────────────
# Пусто = выключен (dev). На проде задать ОБЯЗАТЕЛЬНО: падения фоновых воркеров
# (классификация, ингест, пересборка) без него не увидит никто — они живут в
# отдельных asyncio-тасках и в HTTP-ответ не попадают.
# logger.error/exception автоматически становятся событиями; 4xx отфильтрованы
# как шум; пароли, токены, email и строка подключения к БД вычищаются.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Structured Logs: слать INFO+ логи в Sentry отдельной лентой (не только
# ошибки) — видно проходы автопарсера/воркеров. PII в логах чистится так же,
# как в ошибках. false — оставить только Issues по ошибкам.
SENTRY_ENABLE_LOGS=true

# Геокодер адресных кейсов (карта болей)
DADATA_TOKEN=
DADATA_SECRET=
YANDEX_GEOCODER_KEY=
GEO_MAX_NEW_PER_REQUEST=3
GEO_MISS_TTL_SECONDS=86400
GEO_TIMEOUT_SECONDS=5

# ── Почта: коды подтверждения при регистрации ────────────────────────────────
# Обычный SMTP. Примеры:
#   Яндекс:  SMTP_HOST=smtp.yandex.ru  SMTP_PORT=465  SMTP_USE_SSL=true
#   Mail.ru: SMTP_HOST=smtp.mail.ru    SMTP_PORT=465  SMTP_USE_SSL=true
#   Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_SSL=false  SMTP_USE_TLS=true
# SMTP_PASSWORD — «пароль приложения», а НЕ пароль от учётной записи.
# Если SMTP не задан: на проде регистрация вернёт 503, в dev код пишется
# в лог сервера (в ответ API он не попадает никогда).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=СИГМА
SMTP_USE_SSL=true
SMTP_USE_TLS=false

EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# Публичный адрес фронтенда, который будет вставлен в письмо-приглашение.
# Необязательно: если пусто, backend берёт актуальный Origin браузера.
# На prod можно задать канонический адрес явно, например https://media.example.ru
APP_PUBLIC_URL=
INVITATION_TTL_HOURS=72
INVITATION_RESEND_COOLDOWN_SECONDS=60
